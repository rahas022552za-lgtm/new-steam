<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ระบบเช็คชื่อและจัดการกิจกรรมชุมนุม</title>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  body { font-family: 'Noto Sans Thai', system-ui, sans-serif; }
  .scroll-thin::-webkit-scrollbar { height: 6px; width: 6px; }
  .scroll-thin::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9px; }
</style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen">

<!-- ===================================================================
     วิธีตั้งค่า Firebase (อ่านก่อนใช้งาน)
     -------------------------------------------------------------------
     1) เข้า https://console.firebase.google.com แล้วสร้างโปรเจกต์ใหม่
     2) เมนู Build > Firestore Database > Create database
        (เริ่มด้วย "Test mode" เพื่อทดลอง แล้วค่อยปรับ Rules ภายหลัง)
     3) Project settings (ไอคอนเฟือง) > Your apps > เลือก Web (</>) > Register app
        จะได้ค่า firebaseConfig ให้ก๊อปมาวางในตัวแปร FIREBASE_CONFIG ด้านล่าง
        หรือกดปุ่ม "ตั้งค่า" ในเว็บแล้ววาง JSON ก็ได้ (เก็บไว้ในเบราว์เซอร์เครื่องนั้น)
     4) แนะนำ Firestore Rules สำหรับใช้งานในห้องเรียน (ปรับให้เหมาะสมกับความปลอดภัยที่ต้องการ):
          rules_version = '2';
          service cloud.firestore {
            match /databases/{database}/documents {
              match /{document=**} { allow read, write: if true; }
            }
          }
        ** กฎนี้เปิดให้ทุกคนที่รู้ลิงก์เขียนได้ ควรเพิ่ม Authentication ถ้าใช้งานจริงจัง **
     5) ถ้ายังไม่ตั้งค่า ระบบจะทำงาน "โหมดทดลอง" เก็บข้อมูลในเครื่อง (localStorage)
        ยังไม่ซิงก์ข้ามอุปกรณ์
     =================================================================== -->
<script>
const FIREBASE_CONFIG = {
  apiKey: "",
  authDomain: "",
  projectId: "",
  storageBucket: "",
  messagingSenderId: "",
  appId: ""
};
</script>

<div id="app"></div>
<div id="modal"></div>
<div id="toast" class="fixed bottom-4 left-1/2 -translate-x-1/2 z-[60]"></div>

<script>
/* ============================ ค่าคงที่ ============================ */
const STATUS = {
  present: { label: 'มา',  on: 'bg-emerald-500 text-white border-emerald-500', bar: 'bg-emerald-500', text: 'text-emerald-600' },
  late:    { label: 'สาย', on: 'bg-amber-500 text-white border-amber-500',     bar: 'bg-amber-400',   text: 'text-amber-600' },
  absent:  { label: 'ขาด', on: 'bg-rose-500 text-white border-rose-500',       bar: 'bg-rose-500',    text: 'text-rose-600' },
  leave:   { label: 'ลา',  on: 'bg-violet-500 text-white border-violet-500',   bar: 'bg-violet-400',  text: 'text-violet-600' }
};
const STATUS_KEYS = Object.keys(STATUS);
const MALE = 'ชาย', FEMALE = 'หญิง';

/* ============================ State ============================ */
const S = {
  students: [], weeks: [], weekId: null,
  gender: 'all', search: '', view: 'attendance',
  dashScope: 'term', dashGender: 'all',
  importGender: MALE, importRows: [], importName: '',
  mode: 'local'
};

/* ============================ Utilities ============================ */
const $ = (s) => document.querySelector(s);
const esc = (v) => String(v ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const pctTxt = (n) => n === null || n === undefined ? '–' : n.toFixed(1) + '%';
function toast(msg, ok = true) {
  const t = $('#toast');
  t.innerHTML = `<div class="px-4 py-2 rounded-xl shadow-lg text-white text-sm ${ok ? 'bg-slate-800' : 'bg-rose-600'}">${esc(msg)}</div>`;
  clearTimeout(toast._t); toast._t = setTimeout(() => t.innerHTML = '', 2600);
}
function thaiDate(d) {
  if (!d) return 'ยังไม่ระบุวันที่';
  const dt = new Date(d + 'T00:00:00');
  return isNaN(dt) ? d : dt.toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' });
}
const genderBadge = (g) => g === MALE
  ? '<span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-sky-100 text-sky-700 border border-sky-200">ชาย</span>'
  : '<span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-pink-100 text-pink-700 border border-pink-200">หญิง</span>';
// เรียงตามลำดับในไฟล์ที่นำเข้า (order) ถ้าไม่มี order (ข้อมูลเก่า) จะอยู่ท้ายและเรียงตามชั้น/รหัส
const sortStudents = (a, b) => {
  const ao = typeof a.order === 'number', bo = typeof b.order === 'number';
  if (ao && bo && a.order !== b.order) return a.order - b.order;
  if (ao !== bo) return ao ? -1 : 1;
  return (a.cls || '').localeCompare(b.cls || '', 'th') || String(a.id).localeCompare(String(b.id), 'th', { numeric: true });
};
const sortWeeks = (a, b) => (a.number || 0) - (b.number || 0);
const currentWeek = () => S.weeks.find(w => w.id === S.weekId) || null;
const recOf = (w, id) => (w && w.records && w.records[id]) || null;

/* ============================ Data Layer ============================ */
const Store = {
  db: null, local: { students: {}, weeks: {} },

  init() {
    let cfg = FIREBASE_CONFIG;
    try { const saved = JSON.parse(localStorage.getItem('club_fb_config') || 'null'); if (saved && saved.projectId) cfg = saved; } catch (e) {}
    if (cfg && cfg.apiKey && cfg.projectId) {
      try {
        firebase.initializeApp(cfg);
        this.db = firebase.firestore();
        S.mode = 'firebase';
        this.db.collection('students').onSnapshot(snap => {
          S.students = snap.docs.map(d => ({ id: d.id, ...d.data() })).sort(sortStudents);
          render();
        }, err => toast('เชื่อมต่อ Firebase ไม่สำเร็จ: ' + err.message, false));
        this.db.collection('weeks').onSnapshot(snap => {
          S.weeks = snap.docs.map(d => ({ id: d.id, ...d.data() })).sort(sortWeeks);
          ensureWeek(); render();
        }, err => toast('เชื่อมต่อ Firebase ไม่สำเร็จ: ' + err.message, false));
        return;
      } catch (e) { console.error(e); toast('Firebase Config ไม่ถูกต้อง ใช้โหมดทดลองแทน', false); }
    }
    S.mode = 'local';
    this.loadLocal();
    window.addEventListener('storage', (e) => { if (e.key === 'club_data') { this.loadLocal(); render(); } });
  },
  loadLocal() {
    try { this.local = JSON.parse(localStorage.getItem('club_data')) || { students: {}, weeks: {} }; } catch (e) { this.local = { students: {}, weeks: {} }; }
    this.local.students ||= {}; this.local.weeks ||= {};
    this.syncState();
  },
  syncState() {
    S.students = Object.entries(this.local.students).map(([id, v]) => ({ id, ...v })).sort(sortStudents);
    S.weeks = Object.entries(this.local.weeks).map(([id, v]) => ({ id, ...v })).sort(sortWeeks);
    ensureWeek();
  },
  saveLocal() { localStorage.setItem('club_data', JSON.stringify(this.local)); this.syncState(); render(); },

  async addStudents(list) {
    if (S.mode === 'firebase') {
      for (let i = 0; i < list.length; i += 400) {
        const batch = this.db.batch();
        list.slice(i, i + 400).forEach(s => batch.set(this.db.collection('students').doc(s.id), { name: s.name, cls: s.cls, gender: s.gender, order: s.order }, { merge: true }));
        await batch.commit();
      }
    } else {
      list.forEach(s => this.local.students[s.id] = { name: s.name, cls: s.cls, gender: s.gender, order: s.order });
      this.saveLocal();
    }
  },
  async deleteStudent(id) {
    if (S.mode === 'firebase') await this.db.collection('students').doc(id).delete();
    else { delete this.local.students[id]; this.saveLocal(); }
  },
  async setGender(id, gender) {
    if (S.mode === 'firebase') await this.db.collection('students').doc(id).update({ gender });
    else { this.local.students[id].gender = gender; this.saveLocal(); }
  },
  async clearStudents() {
    if (S.mode === 'firebase') {
      const snap = await this.db.collection('students').get();
      for (let i = 0; i < snap.docs.length; i += 400) {
        const b = this.db.batch(); snap.docs.slice(i, i + 400).forEach(d => b.delete(d.ref)); await b.commit();
      }
    } else { this.local.students = {}; this.saveLocal(); }
  },
  async saveWeek(w) {
    const data = { number: w.number, date: w.date, topic: w.topic, supervisors: w.supervisors };
    if (S.mode === 'firebase') await this.db.collection('weeks').doc(w.id).set(data, { merge: true });
    else { this.local.weeks[w.id] = { ...(this.local.weeks[w.id] || { records: {} }), ...data }; this.saveLocal(); }
  },
  async deleteWeek(id) {
    if (S.mode === 'firebase') await this.db.collection('weeks').doc(id).delete();
    else { delete this.local.weeks[id]; this.saveLocal(); }
  },
  // map: { studentId: 'present' | 'late' | 'absent' | 'leave' | null(ล้างค่า) }
  async setRecords(weekId, map) {
    if (S.mode === 'firebase') {
      const rec = {};
      Object.entries(map).forEach(([id, v]) => rec[id] = v === null ? firebase.firestore.FieldValue.delete() : v);
      await this.db.collection('weeks').doc(weekId).set({ records: rec }, { merge: true });
    } else {
      const w = this.local.weeks[weekId]; w.records ||= {};
      Object.entries(map).forEach(([id, v]) => { if (v === null) delete w.records[id]; else w.records[id] = v; });
      this.saveLocal();
    }
  }
};

function ensureWeek() {
  if (!S.weeks.find(w => w.id === S.weekId)) S.weekId = S.weeks.length ? S.weeks[S.weeks.length - 1].id : null;
}

/* ============================ Stats ============================ */
function tally(studs, weeks) {
  const c = { present: 0, late: 0, absent: 0, leave: 0 };
  weeks.forEach(w => studs.forEach(s => { const r = recOf(w, s.id); if (r && c[r] !== undefined) c[r]++; }));
  c.total = c.present + c.late + c.absent + c.leave;
  c.pct = c.total ? (c.present + c.late) / c.total * 100 : null; // มา+สาย นับเป็นเข้าเรียน
  return c;
}
const byGender = (g) => g === 'all' ? S.students : S.students.filter(s => s.gender === g);

/* ============================ Render ============================ */
function render() {
  const modeBadge = S.mode === 'firebase'
    ? '<span class="flex items-center gap-1.5 text-xs text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-full"><span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>ซิงก์เรียลไทม์ (Firebase)</span>'
    : '<span class="flex items-center gap-1.5 text-xs text-amber-700 bg-amber-50 border border-amber-200 px-2.5 py-1 rounded-full"><span class="w-2 h-2 rounded-full bg-amber-500"></span>โหมดทดลอง (เก็บในเครื่อง)</span>';
  const tabs = [['attendance', 'เช็คชื่อ'], ['weeks', 'สัปดาห์กิจกรรม'], ['dashboard', 'แดชบอร์ด'], ['students', 'สมาชิก']];
  $('#app').innerHTML = `
  <header class="bg-gradient-to-r from-indigo-600 to-blue-600 text-white">
    <div class="max-w-6xl mx-auto px-4 py-4 flex flex-wrap items-center justify-between gap-3">
      <div>
        <h1 class="text-xl sm:text-2xl font-bold">ระบบเช็คชื่อและจัดการกิจกรรมชุมนุม</h1>
        <p class="text-indigo-100 text-sm">Club Attendance &amp; Weekly Management</p>
      </div>
      <div class="flex items-center gap-2">${modeBadge}
        <button data-act="open-settings" class="text-sm bg-white/15 hover:bg-white/25 px-3 py-1.5 rounded-lg">ตั้งค่า</button>
      </div>
    </div>
    <nav class="max-w-6xl mx-auto px-4 flex gap-1 overflow-x-auto scroll-thin">
      ${tabs.map(([k, l]) => `<button data-act="view" data-v="${k}" class="px-4 py-2.5 text-sm font-medium whitespace-nowrap rounded-t-xl ${S.view === k ? 'bg-slate-50 text-indigo-700' : 'text-indigo-100 hover:bg-white/10'}">${l}</button>`).join('')}
    </nav>
  </header>
  <main class="max-w-6xl mx-auto px-4 py-5">
    ${S.view === 'attendance' ? viewAttendance() : S.view === 'weeks' ? viewWeeks() : S.view === 'dashboard' ? viewDashboard() : viewStudents()}
  </main>`;
}

/* ---------- หน้าเช็คชื่อ ---------- */
function weekSelector() {
  if (!S.weeks.length) return '';
  const idx = S.weeks.findIndex(w => w.id === S.weekId);
  return `<div class="flex items-center gap-2">
    <button data-act="prev-week" ${idx <= 0 ? 'disabled' : ''} class="w-9 h-9 rounded-lg border bg-white hover:bg-slate-100 disabled:opacity-30">‹</button>
    <select data-act="select-week" class="flex-1 min-w-0 h-9 px-3 rounded-lg border bg-white text-sm font-medium">
      ${S.weeks.map(w => `<option value="${esc(w.id)}" ${w.id === S.weekId ? 'selected' : ''}>วีค ${w.number}${w.date ? ' · ' + esc(w.date) : ''}</option>`).join('')}
    </select>
    <button data-act="next-week" ${idx >= S.weeks.length - 1 ? 'disabled' : ''} class="w-9 h-9 rounded-lg border bg-white hover:bg-slate-100 disabled:opacity-30">›</button>
  </div>`;
}
function genderTabs(current, act) {
  const items = [['all', 'ทั้งหมด', S.students.length], [MALE, 'เฉพาะนักเรียนชาย', byGender(MALE).length], [FEMALE, 'เฉพาะนักเรียนหญิง', byGender(FEMALE).length]];
  const col = { all: 'bg-indigo-600', [MALE]: 'bg-sky-500', [FEMALE]: 'bg-pink-500' };
  return `<div class="flex gap-1.5 overflow-x-auto scroll-thin">${items.map(([k, l, n]) =>
    `<button data-act="${act}" data-g="${k}" class="px-3.5 py-1.5 rounded-full text-sm font-medium whitespace-nowrap border ${current === k ? col[k] + ' text-white border-transparent' : 'bg-white text-slate-600 hover:bg-slate-100'}">${l} <span class="opacity-80">(${n})</span></button>`).join('')}</div>`;
}
function viewAttendance() {
  if (!S.weeks.length) return emptyBox('ยังไม่มีสัปดาห์กิจกรรม', 'เพิ่มสัปดาห์แรกเพื่อเริ่มเช็คชื่อ', `<button data-act="goto-weeks" class="mt-3 px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm">ไปหน้าสัปดาห์กิจกรรม</button>`);
  if (!S.students.length) return emptyBox('ยังไม่มีรายชื่อสมาชิก', 'นำเข้าไฟล์ Excel/CSV เพื่อเพิ่มรายชื่อ', `<button data-act="open-import" class="mt-3 px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm">นำเข้ารายชื่อ</button>`);
  const w = currentWeek();
  return `
  <div class="bg-white rounded-2xl shadow-sm border p-4 mb-4">
    <div class="grid md:grid-cols-2 gap-4">
      <div>${weekSelector()}
        <p class="mt-3 text-sm text-slate-500">${thaiDate(w.date)}</p>
        <p class="font-semibold mt-1">${esc(w.topic) || '<span class="text-slate-400 font-normal">ยังไม่ระบุหัวข้อกิจกรรม</span>'}</p>
      </div>
      <div>
        <p class="text-xs text-slate-500 mb-1.5">ผู้ดูแลรับผิดชอบประจำสัปดาห์</p>
        <div class="flex flex-wrap gap-1.5">${(w.supervisors || []).length ? w.supervisors.map(n => `<span class="px-2.5 py-1 bg-indigo-50 text-indigo-700 rounded-full text-sm">${esc(n)}</span>`).join('') : '<span class="text-sm text-slate-400">ยังไม่ระบุ</span>'}</div>
      </div>
    </div>
  </div>
  <div class="bg-white rounded-2xl shadow-sm border p-4">
    <div class="mb-3">${genderTabs(S.gender, 'gender-tab')}</div>
    <div class="flex flex-wrap gap-2 mb-3">
      <input id="search" value="${esc(S.search)}" placeholder="ค้นหาชื่อ / รหัส / ห้อง" class="flex-1 min-w-[180px] h-10 px-3 rounded-lg border text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300">
      <button data-act="mark-all" class="h-10 px-4 rounded-lg bg-emerald-500 hover:bg-emerald-600 text-white text-sm font-medium">✓ กดมาทั้งหมด${S.gender === 'all' ? '' : ' (' + S.gender + ')'}</button>
      <button data-act="clear-all" class="h-10 px-3 rounded-lg border text-sm text-slate-600 hover:bg-slate-100">ล้างค่า</button>
    </div>
    <div id="list">${attendanceList()}</div>
  </div>`;
}
function filteredStudents() {
  const q = S.search.trim().toLowerCase();
  return byGender(S.gender).filter(s => !q || (s.name + ' ' + s.id + ' ' + (s.cls || '')).toLowerCase().includes(q));
}
function attendanceList() {
  const w = currentWeek(); const list = filteredStudents();
  const t = tally(list, [w]);
  const summary = `<div class="flex flex-wrap gap-x-4 gap-y-1 text-sm mb-3 text-slate-600">
    <span>แสดง ${list.length} คน</span>
    ${STATUS_KEYS.map(k => `<span class="${STATUS[k].text}">${STATUS[k].label} ${t[k]}</span>`).join('')}
    <span class="text-slate-400">ยังไม่เช็ค ${list.length - t.total}</span></div>`;
  if (!list.length) return summary + '<p class="text-center text-slate-400 py-8 text-sm">ไม่พบรายชื่อ</p>';
  return summary + `<div class="divide-y">${list.map((s, i) => {
    const cur = recOf(w, s.id);
    return `<div class="py-2.5 flex flex-wrap items-center gap-x-3 gap-y-2">
      <span class="w-7 text-xs text-slate-400 text-right">${i + 1}</span>
      <div class="flex-1 min-w-[180px]">
        <div class="flex items-center gap-2 flex-wrap"><span class="font-medium text-sm">${esc(s.name)}</span>${genderBadge(s.gender)}</div>
        <div class="text-xs text-slate-500">รหัส ${esc(s.id)}${s.cls ? ' · ' + esc(s.cls) : ''}</div>
      </div>
      <div class="flex gap-1">${STATUS_KEYS.map(k => `<button data-act="set-status" data-id="${esc(s.id)}" data-s="${k}" class="w-12 h-9 rounded-lg border text-sm font-medium ${cur === k ? STATUS[k].on : 'bg-white text-slate-500 hover:bg-slate-100'}">${STATUS[k].label}</button>`).join('')}</div>
    </div>`;
  }).join('')}</div>`;
}

/* ---------- หน้าสัปดาห์กิจกรรม ---------- */
function viewWeeks() {
  return `
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-bold">สัปดาห์กิจกรรมและผู้ดูแล</h2>
    <button data-act="add-week" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-sm font-medium">+ เพิ่มสัปดาห์ใหม่</button>
  </div>
  ${S.weeks.length ? `<div class="grid md:grid-cols-2 gap-3">${S.weeks.map(w => {
    const t = tally(S.students, [w]);
    return `<div class="bg-white rounded-2xl border shadow-sm p-4">
      <div class="flex items-start justify-between gap-2">
        <div><span class="text-xs px-2 py-0.5 rounded-full bg-indigo-100 text-indigo-700 font-medium">วีค ${w.number}</span>
        <p class="text-sm text-slate-500 mt-1.5">${thaiDate(w.date)}</p></div>
        <div class="text-right"><p class="text-xs text-slate-400">เข้าเรียน</p><p class="font-bold text-lg">${pctTxt(t.pct)}</p></div>
      </div>
      <p class="font-semibold mt-2">${esc(w.topic) || '<span class="text-slate-400 font-normal">ยังไม่ระบุหัวข้อ</span>'}</p>
      <div class="flex flex-wrap gap-1.5 mt-2">${(w.supervisors || []).map(n => `<span class="px-2 py-0.5 bg-slate-100 rounded-full text-xs">${esc(n)}</span>`).join('') || '<span class="text-xs text-slate-400">ยังไม่ระบุผู้ดูแล</span>'}</div>
      <div class="flex gap-2 mt-3">
        <button data-act="check-week" data-id="${esc(w.id)}" class="px-3 py-1.5 rounded-lg bg-emerald-500 text-white text-sm">เช็คชื่อ</button>
        <button data-act="edit-week" data-id="${esc(w.id)}" class="px-3 py-1.5 rounded-lg border text-sm hover:bg-slate-100">แก้ไข</button>
        <button data-act="del-week" data-id="${esc(w.id)}" class="px-3 py-1.5 rounded-lg border border-rose-200 text-rose-600 text-sm hover:bg-rose-50">ลบ</button>
      </div></div>`;
