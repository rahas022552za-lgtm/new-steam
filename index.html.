async function parseFile(file) {
  const buf = await file.arrayBuffer();
  const wb = XLSX.read(buf, { type: 'array' });
  const data = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]], { header: 1, defval: '' });
  const norm = (v) => String(v).replace(/\s/g, '').toLowerCase();
  let hIdx = -1, iId = 0, iName = 1, iCls = 2;
  for (let i = 0; i < Math.min(data.length, 10); i++) {
    const r = data[i].map(norm);
    const a = r.findIndex(c => /รหัส|^id$|studentid/.test(c));
    const b = r.findIndex(c => /ชื่อ|name/.test(c));
    if (a >= 0 || b >= 0) {
      hIdx = i;
      if (a >= 0) iId = a; if (b >= 0) iName = b;
      const c = r.findIndex(c => /ชั้น|ห้อง|class|room/.test(c)); if (c >= 0) iCls = c;
      break;
    }
  }
  const rows = []; rows.fixed = 0;
  // Excel มักแปลงค่าอย่าง "4/9" เป็นวันที่ (เก็บเป็นเลข เช่น 46270) -> แปลงกลับเป็น วัน/เดือน
  const toClass = (v) => {
    if (v instanceof Date) { rows.fixed++; return v.getDate() + '/' + (v.getMonth() + 1); }
    if (typeof v === 'number' && v > 20000 && v < 80000) {
      const d = XLSX.SSF.parse_date_code(v);
      if (d) { rows.fixed++; return d.d + '/' + d.m; }
    }
    return String(v ?? '').trim();
  };
  data.slice(hIdx + 1).forEach((r, n) => {
    const name = String(r[iName] ?? '').trim(); if (!name) return;
    let id = String(r[iId] ?? '').trim().replace(/\//g, '-');
    if (!id) id = 'S' + Date.now().toString(36) + n;
    rows.push({ id, name, cls: toClass(r[iCls]) });
  });
  return rows;
}

