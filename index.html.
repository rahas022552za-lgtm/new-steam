document.addEventListener('click', async (e) => {
  const el = e.target.closest('[data-act]'); if (!el) return;
  const act = el.dataset.act, id = el.dataset.id;
  if (act === 'backdrop') { if (e.target === el) closeModal(); return; }
  try {
    switch (act) {
      case 'view': S.view = el.dataset.v; render(); break;
      case 'goto-weeks': S.view = 'weeks'; render(); break;
      case 'gender-tab': S.gender = el.dataset.g; render(); break;
      case 'dash-gender': S.dashGender = el.dataset.g; render(); break;
      case 'scope': S.dashScope = el.dataset.v; render(); break;
      case 'prev-week': case 'next-week': {
        const i = S.weeks.findIndex(w => w.id === S.weekId) + (act === 'next-week' ? 1 : -1);
        if (S.weeks[i]) { S.weekId = S.weeks[i].id; render(); } break;
      }
      case 'set-status': {
        const w = currentWeek(); const same = recOf(w, id) === el.dataset.s;
        await Store.setRecords(w.id, { [id]: same ? null : el.dataset.s }); break;
      }
      case 'mark-all': {
        const list = byGender(S.gender); if (!list.length) return toast('ไม่มีรายชื่อในกลุ่มนี้', false);
        const map = {}; list.forEach(s => map[s.id] = 'present');
        await Store.setRecords(S.weekId, map);
        toast(`บันทึก "มา" ให้ ${S.gender === 'all' ? 'ทุกคน' : 'นักเรียน' + S.gender} ${list.length} คน`); break;
      }
      case 'clear-all': {
        const list = byGender(S.gender); if (!list.length || !confirm(`ล้างผลเช็คชื่อของ ${list.length} คนในกลุ่มที่แสดงอยู่?`)) return;
        const map = {}; list.forEach(s => map[s.id] = null); await Store.setRecords(S.weekId, map); break;
      }
      case 'add-week': weekModal(); break;
      case 'edit-week': weekModal(id); break;
      case 'check-week': S.weekId = id; S.view = 'attendance'; render(); break;
      case 'save-week': {
        const num = +el.dataset.num;
        const sup = $('#w-sup').value.split(/[,\n]/).map(x => x.trim()).filter(Boolean);
        await Store.saveWeek({ id: id || 'week-' + String(num).padStart(3, '0'), number: num, date: $('#w-date').value, topic: $('#w-topic').value.trim(), supervisors: sup });
        if (!id) S.weekId = 'week-' + String(num).padStart(3, '0');
        closeModal(); toast('บันทึกสัปดาห์แล้ว'); break;
      }
      case 'del-week': if (confirm('ลบสัปดาห์นี้พร้อมผลเช็คชื่อทั้งหมดของสัปดาห์?')) await Store.deleteWeek(id); break;
      case 'open-import': S.importRows = []; importModal(); break;
      case 'sample-csv': {
        const csv = '\uFEFFรหัสนักเรียน,ชื่อ-นามสกุล,ชั้น/ห้อง\n12345,เด็กชายสมชาย ใจดี,ม.1/1\n12346,เด็กชายสมศักดิ์ รักเรียน,ม.1/2\n';
        const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' })); a.download = 'ตัวอย่างรายชื่อ.csv'; a.click(); break;
      }
      case 'do-import': {
        const gender = (document.querySelector('input[name=ig]:checked') || {}).value || MALE;
        // กำหนดลำดับตามไฟล์: ไฟล์ที่นำเข้าก่อนอยู่ก่อน, แถวในไฟล์เรียงตามเดิม
        const base = S.students.reduce((m, s) => Math.max(m, typeof s.order === 'number' ? s.order : 0), 0);
        const list = S.importRows.map((r, i) => {
          const old = S.students.find(s => s.id === r.id);
          return { ...r, gender, order: (old && typeof old.order === 'number') ? old.order : base + i + 1 };
        });
        el.disabled = true; el.textContent = 'กำลังนำเข้า...';
        await Store.addStudents(list); closeModal(); toast(`นำเข้า ${list.length} รายชื่อ (${gender}) สำเร็จ`); break;
      }
      case 'toggle-gender': { const s = S.students.find(x => x.id === id); await Store.setGender(id, s.gender === MALE ? FEMALE : MALE); break; }
      case 'del-student': if (confirm('ลบสมาชิกคนนี้?')) await Store.deleteStudent(id); break;
      case 'clear-students': if (confirm('ลบรายชื่อสมาชิกทั้งหมด? (ผลเช็คชื่อเดิมจะไม่ถูกนับในสถิติ)')) await Store.clearStudents(); break;
      case 'open-settings': settingsModal(); break;
      case 'save-cfg': {
        try { const c = JSON.parse($('#cfg-text').value); if (!c.apiKey || !c.projectId) throw 0; localStorage.setItem('club_fb_config', JSON.stringify(c)); location.reload(); }
        catch (_) { toast('JSON ไม่ถูกต้อง หรือขาด apiKey / projectId', false); } break;
      }
      case 'reset-cfg': localStorage.removeItem('club_fb_config'); location.reload(); break;
      case 'close-modal': closeModal(); break;
    }
  } catch (err) { console.error(err); toast('เกิดข้อผิดพลาด: ' + err.message, false); }
});

document.addEventListener('change', async (e) => {
  if (e.target.matches('[data-act="select-week"]')) { S.weekId = e.target.value; render(); }
  if (e.target.id === 'import-file' && e.target.files[0]) {
    try { S.importRows = await parseFile(e.target.files[0]); S.importName = e.target.files[0].name; renderImportPreview(); if (!S.importRows.length) toast('ไม่พบรายชื่อในไฟล์', false); }
    catch (err) { console.error(err); toast('อ่านไฟล์ไม่สำเร็จ', false); }
  }
  if (e.target.name === 'ig') { S.importGender = e.target.value; if (S.importRows.length) renderImportPreview(); }
});
document.addEventListener('input', (e) => {
  if (e.target.id === 'search') { S.search = e.target.value; $('#list').innerHTML = attendanceList(); }
});

/* ============================ Start ============================ */
Store.init();
render();
</script>
</body>
</html>
